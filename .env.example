# CogLigandBench environment variables
# Copy this file to .env and fill in the paths for the methods you want to use.
# Methods not listed here (vina, gnina, unidock2) use only PROJECT_ROOT and
# standard binaries (obabel, vina, gnina) that must be on $PATH.

# ------------------------------------------------------------------
# DynamicBind
# Path to the DynamicBind conda env Python and the DynamicBind repo root.
# Install: mamba env create -f environments/dynamicbind_environment.yaml --prefix forks/DynamicBind/DynamicBind/
# ------------------------------------------------------------------
DYNAMICBIND_PYTHON=/path/to/forks/DynamicBind/DynamicBind/bin/python3
DYNAMICBIND_DIR=/path/to/forks/DynamicBind

# ------------------------------------------------------------------
# SurfDock (single-molecule mode)
# Requires a local SurfDock installation with MSMS/APBS/pdb2pqr binaries
# and an editable ESM install. The git submodule at forks/SurfDock/ only
# contains code and model weights.
# Install: see forks/SurfDock/README.md
# ------------------------------------------------------------------
SURFDOCK_DIR=/path/to/your/SurfDock/installation
SURFDOCK_PRECOMPUTED_ARRAYS=/path/to/precomputed/precomputed_arrays

# ------------------------------------------------------------------
# SurfDock (dataset/batch mode only — not needed for single-molecule mode)
# Pre-computed inputs for the runsNposes benchmark.
# ------------------------------------------------------------------
# SURFDOCK_INPUTS_CSV=/path/to/surfdock_runsNposes_benchmark_inputs.csv
# SURFDOCK_ESM_EMBEDDINGS=/path/to/esm2_3billion_pdbbind_embeddings.pt
# SURFDOCK_SURFACE_DIR=/path/to/8A_surface

# ------------------------------------------------------------------
# Chai-1
# No env var needed for the Python path if you pass python_exec_path= directly:
#   dock_engine('chai', protein=..., ligand=..., python_exec_path='/path/to/chai-lab/bin/python')
# Install: mamba env create -f environments/chai_lab_environment.yaml --prefix forks/chai-lab/chai-lab/
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# GNINA binary
# Not on PATH by default — place the binary at forks/GNINA/gnina
# Download: https://github.com/gnina/gnina/releases
# ------------------------------------------------------------------
