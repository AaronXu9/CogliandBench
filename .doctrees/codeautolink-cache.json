      "source": "from cogligandbench import dock_engine\n\n# Single molecule\nresult = dock_engine(\n    'vina',\n    protein='receptor.pdb',\n    ligand='ligand.sdf',\n    output_dir='./results',\n)\n\n# Full runsNposes benchmark\ndock_engine('gnina', dataset='runsNposes')\ndock_engine('gnina', dataset='runsNposes', repeat_index=1)",
